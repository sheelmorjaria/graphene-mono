# Dependencies
node_modules

# Environment variables
.env
.env.local
.env.production.local
.env.development.local

# Build outputs
dist
dist-ssr
build
*.local

# Test coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Backend specific
apps/backend/logs/*.json
apps/backend/tmp/

# Windows Zone.Identifier files (created when downloading from web)
*:Zone.Identifier
*.Identifier:*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Deployment
.vercel
.claude

# Markdown files (as per original gitignore)
*.md
!CLAUDE.md
# Deployment env variants & backups — contain credentials, never commit
.env.web
.env.tor
.env.web.backup
.env.tor.backup
**/.env.backup
**/.env.*.backup

# Aegis installer kit — signing material and build artefacts never commit.
# The keystore MUST be backed up offline: every future kit update has to be
# signed with the SAME key or customers cannot upgrade in place.
aegis-kit/aegis-release.keystore
aegis-kit/.keystore-password
aegis-kit/*.zip
aegis-kit/*.apk

# Aegis engine build workspace (canonical source lives in the separate
# engine repo/tar) and stray local artefacts
aegis-engine-extract/
aegis-engine-src.zip
workspace-*.tar
.aider-desk/
.aider.input.history
aegis-kit/*.idsig

# Delivery artefacts ship in the repo (Option B) — the web installer and
# download links serve them from the backend image. Narrow exceptions to
# the *.zip/*.apk rules above; signing material above stays ignored.
!aegis-kit/aegis-installer-kit.zip
!aegis-kit/aegis-engine.apk
