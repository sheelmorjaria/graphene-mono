{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM node:20-alpine AS base",
    "RUN apk add --no-cache python3 make g++ curl",
    "WORKDIR /app",
    "COPY apps/backend/package.json ./apps/backend/",
    "WORKDIR /app/apps/backend",
    "RUN npm install --only=production --legacy-peer-deps",
    "COPY apps/backend ./apps/backend",
    "RUN addgroup -g 1001 -S nodejs && \\",
    "    adduser -S nodejs -u 1001",
    "RUN mkdir -p uploads/products logs && \\",
    "    chown -R nodejs:nodejs uploads logs",
    "RUN apk add --no-cache tini curl",
    "USER nodejs",
    "EXPOSE 5000",
    "ENTRYPOINT [\"/sbin/tini\", \"--\"]",
    "CMD [\"sh\", \"-c\", \"echo '🚀 Starting backend container...' && node --version && npm --version && echo '📁 Starting server...' && node server.js\"]"
  ],
  "containerHttpPort": 5000,
  "healthCheckPath": "/health",
  "healthCheckInterval": 30000,
  "healthCheckTimeout": 3000,
  "healthCheckStartDelay": 40000,
  "healthCheckRetries": 3,
  "volumes": [
    {
      "volumeName": "backend-uploads",
      "containerPath": "/app/apps/backend/uploads"
    },
    {
      "volumeName": "backend-logs",
      "containerPath": "/app/apps/backend/logs"
    }
  ],
  "envVars": [
    {
      "id": "MONGODB_URI",
      "description": "MongoDB connection string (required)",
      "defaultValue": "",
      "advanced": false,
      "required": true
    },
    {
      "id": "JWT_SECRET",
      "description": "JWT signing secret for authentication (required)",
      "defaultValue": "",
      "advanced": false,
      "required": true
    },
    {
      "id": "PORT",
      "description": "Backend server port",
      "defaultValue": "5000",
      "advanced": true
    },
    {
      "id": "NODE_ENV",
      "description": "Node environment",
      "defaultValue": "production",
      "advanced": true
    },
    {
      "id": "PAYPAL_CLIENT_ID",
      "description": "PayPal client ID",
      "defaultValue": "",
      "advanced": false
    },
    {
      "id": "PAYPAL_CLIENT_SECRET",
      "description": "PayPal client secret",
      "defaultValue": "",
      "advanced": true
    },
    {
      "id": "COIN_GECKO_API_KEY",
      "description": "CoinGecko API key for crypto exchange rates",
      "defaultValue": "",
      "advanced": true
    },
    {
      "id": "BLOCKONOMICS_CALLBACK_SECRET",
      "description": "Blockonomics callback secret for Bitcoin payments",
      "defaultValue": "",
      "advanced": true
    },
    {
      "id": "GLOBEE_API_KEY",
      "description": "GloBee API key for Monero payments",
      "defaultValue": "",
      "advanced": true
    },
    {
      "id": "GLOBEE_API_SECRET",
      "description": "GloBee API secret for Monero payments",
      "defaultValue": "",
      "advanced": true
    },
    {
      "id": "ADMIN_EMAIL",
      "description": "Admin user email",
      "defaultValue": "admin@grapheneosstore.com",
      "advanced": false
    },
    {
      "id": "SUPPORT_EMAIL",
      "description": "Support email address",
      "defaultValue": "support@graphene-security.com",
      "advanced": false
    },
    {
      "id": "FRONTEND_URL",
      "description": "Frontend URL for CORS",
      "defaultValue": "https://graphene-security.com",
      "advanced": true
    }
  ]
}
