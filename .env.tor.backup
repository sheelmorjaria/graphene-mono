# Tor deployment environment variables
# Copy this to .env for Tor deployment

# MongoDB Configuration (same database as web)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_password_here
MONGO_DATABASE=graphene_store
MONGODB_URI=mongodb://admin:your_secure_password_here@mongodb:27017/graphene_store?authSource=admin

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here

# Backend Configuration
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here
PORT=5000

# Frontend Configuration - Tor Version
VITE_API_BASE_URL=/api
VITE_APP_TITLE=GrapheneOS Store - Tor
VITE_COMPANY_NAME=Graphene Security
VITE_SUPPORT_EMAIL=support@grapheneos-store.com

# Payment Configuration - Crypto only for Tor
VITE_ENABLE_PAYPAL_PAYMENTS=false
VITE_ENABLE_BITCOIN_PAYMENTS=true
VITE_ENABLE_MONERO_PAYMENTS=true

# Crypto Configuration (PayPal disabled)
BLOCKONOMICS_API_KEY=your_blockonomics_key
MONERO_WALLET_ADDRESS=your_monero_address

# Feature Flags
VITE_ENABLE_DEV_TOOLS=false
VITE_MAINTENANCE_MODE=false

# Tor-specific settings
VITE_IS_TOR_DEPLOYMENT=true
VITE_SHOW_TOR_NOTICE=true