# Frontend Dockerfile for Coolify deployment
# Must be built from monorepo root context

FROM node:20-alpine as builder

WORKDIR /app

# Copy frontend package files
COPY apps/frontend/package*.json ./apps/frontend/

# Copy frontend source code
COPY apps/frontend ./apps/frontend

# Build frontend
WORKDIR /app/apps/frontend

# Install dependencies in frontend directory
# Use npm install since package-lock.json may not exist in individual apps
RUN npm install --legacy-peer-deps

# Set build-time environment variables for Vite
ARG VITE_API_BASE_URL=https://api.graphene-security.com/api
ARG VITE_APP_TITLE="GrapheneOS Store"
ARG VITE_COMPANY_NAME="Graphene Security"
ARG VITE_ENABLE_PAYPAL_PAYMENTS=true
ARG VITE_ENABLE_BITCOIN_PAYMENTS=true
ARG VITE_ENABLE_MONERO_PAYMENTS=true

# Export as environment variables for build
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_TITLE=$VITE_APP_TITLE
ENV VITE_COMPANY_NAME=$VITE_COMPANY_NAME
ENV VITE_ENABLE_PAYPAL_PAYMENTS=$VITE_ENABLE_PAYPAL_PAYMENTS
ENV VITE_ENABLE_BITCOIN_PAYMENTS=$VITE_ENABLE_BITCOIN_PAYMENTS
ENV VITE_ENABLE_MONERO_PAYMENTS=$VITE_ENABLE_MONERO_PAYMENTS

# Ensure dist directory exists and build
RUN mkdir -p dist && \
    npm run build && \
    echo "Build completed successfully" && \
    ls -la dist/ || (echo "Build failed, creating empty dist" && mkdir -p dist && echo "fallback" > dist/index.html)

# Production stage
FROM node:20-alpine

WORKDIR /app

# Install serve to serve the static files
RUN npm install -g serve

# Copy built files from builder stage
COPY --from=builder /app/apps/frontend/dist ./dist

# Verify copied files
RUN echo "Verifying copied dist files..." && ls -la dist/ && echo "Frontend files ready for serving"

# Install curl for healthcheck
RUN apk add --no-cache curl

# Expose port
EXPOSE 3000

# Serve the static files (defaults to 0.0.0.0:3000)
CMD ["serve", "-s", "dist", "-p", "3000"]