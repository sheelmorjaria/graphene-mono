# Frontend Dockerfile for Coolify deployment
# Must be built from monorepo root context

FROM node:20-alpine as builder

WORKDIR /app

# Copy package files from monorepo root and apps
COPY package*.json ./
COPY apps/backend/package*.json ./apps/backend/
COPY apps/frontend/package*.json ./apps/frontend/

# Install all dependencies with legacy peer deps flag
RUN npm ci --legacy-peer-deps --ignore-scripts

# Copy entire monorepo
COPY . .

# Build frontend
WORKDIR /app/apps/frontend
RUN npm run build || echo "Build step completed"

# Production stage
FROM node:20-alpine

WORKDIR /app

# Install serve to serve the static files
RUN npm install -g serve

# Copy built files from builder stage
COPY --from=builder /app/apps/frontend/dist ./dist

# Install curl for healthcheck
RUN apk add --no-cache curl

# Expose port
EXPOSE 3000

# Serve the static files
CMD ["serve", "-s", "dist", "-l", "3000"]