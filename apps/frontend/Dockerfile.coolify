# Frontend Dockerfile for Coolify deployment
# Must be built from monorepo root context

FROM node:20-alpine as builder

WORKDIR /app

# Copy package files from monorepo root and apps
COPY package*.json ./
COPY apps/backend/package*.json ./apps/backend/
COPY apps/frontend/package*.json ./apps/frontend/

# Copy entire monorepo first
COPY . .

# Install all dependencies without ignore-scripts to properly set up build tools
RUN npm ci --legacy-peer-deps

# Build frontend
WORKDIR /app/apps/frontend
RUN npm run build

# Production stage
FROM node:20-alpine

WORKDIR /app

# Install serve to serve the static files
RUN npm install -g serve

# Copy built files from builder stage
COPY --from=builder /app/apps/frontend/dist ./dist

# Install curl for healthcheck
RUN apk add --no-cache curl

# Expose port
EXPOSE 3000

# Serve the static files
CMD ["serve", "-s", "dist", "-l", "3000"]