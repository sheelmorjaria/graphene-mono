# Test environment — loaded automatically by Vite/vitest in test mode.
# Committed on purpose: these are public build-time values (no secrets) and
# the test suite depends on them. Without this file, VITE_API_BASE_URL is
# undefined and ~46 test files fail (URL assertions get "undefined/...").
# Local .env still wins for dev server runs; .env.test applies to `npm test`.

# API Configuration - backend test double runs on port 5000
VITE_API_BASE_URL=http://localhost:5000/api

# Application Configuration
VITE_APP_TITLE=GrapheneOS Store
VITE_COMPANY_NAME=Graphene Security
VITE_SUPPORT_EMAIL=support@grapheneos-store.com

# PayPal (sandbox placeholder; the SDK is mocked in tests)
VITE_PAYPAL_CLIENT_ID=your-sandbox-paypal-client-id

VITE_ENABLE_BITCOIN_PAYMENTS=true
VITE_ENABLE_MONERO_PAYMENTS=true
VITE_ENABLE_PAYPAL_PAYMENTS=true
VITE_ENABLE_DEV_TOOLS=true

# SEO defaults asserted by meta tests
VITE_META_DESCRIPTION=Privacy-focused smartphones with GrapheneOS. Secure, private mobile devices for enhanced digital privacy.
VITE_META_KEYWORDS=GrapheneOS,privacy,smartphone,security,mobile,android
