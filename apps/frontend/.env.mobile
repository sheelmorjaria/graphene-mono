# API Configuration for Mobile Testing
# Replace YOUR_COMPUTER_IP with your actual computer's IP address
# You can find it using: ip a | grep "inet " | grep -v 127.0.0.1
# Example: 192.168.1.100
VITE_API_BASE_URL=http://YOUR_COMPUTER_IP:5000/api

# Stripe Configuration (frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here