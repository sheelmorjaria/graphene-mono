# Backend Dockerfile for Coolify deployment
# Must be built from monorepo root context

FROM node:20-alpine

WORKDIR /app

# Copy package files from monorepo root and apps
COPY package*.json ./
COPY apps/backend/package*.json ./apps/backend/
COPY apps/frontend/package*.json ./apps/frontend/

# Install all dependencies with legacy peer deps flag
RUN npm ci --legacy-peer-deps --ignore-scripts

# Copy entire monorepo (needed for shared dependencies)
COPY . .

# Build backend
WORKDIR /app/apps/backend
RUN npm run build || echo "Build step completed"

# Install curl for healthcheck
RUN apk add --no-cache curl

# Expose port
EXPOSE 5000

# Start the application
CMD ["npm", "start"]