{
  "name": "@graphene-security/backend",
  "version": "1.0.0",
  "description": "Graphene Security Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest --config vitest.config.unit.js",
    "test:watch": "vitest --config vitest.config.unit.js --watch",
    "test:ui": "vitest --ui",
    "test:unit": "vitest --config vitest.config.unit.js",
    "test:unit:watch": "vitest --config vitest.config.unit.js --watch",
    "test:models": "vitest --config vitest.model.config.js",
    "test:models:watch": "vitest --config vitest.model.config.js --watch",
    "test:integration": "vitest --config vitest.integration.config.js",
    "test:integration:watch": "vitest --config vitest.integration.config.js --watch",
    "test:e2e": "vitest --config vitest.config.e2e.js",
    "test:e2e:watch": "vitest --config vitest.config.e2e.js --watch",
    "test:performance": "vitest --config vitest.config.performance.js",
    "test:performance:watch": "vitest --config vitest.config.performance.js --watch",
    "test:security": "vitest --config vitest.config.security.js",
    "test:security:watch": "vitest --config vitest.config.security.js --watch",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run test:unit && npm run test:integration",
    "test:coverage": "vitest --config vitest.config.unit.js --coverage --no-file-parallelism",
    "test:coverage:integration": "vitest --config vitest.integration.config.js --coverage --forceExit",
    "test:coverage:models": "vitest --config vitest.model.config.js --coverage --forceExit",
    "test:coverage:all": "vitest --config vitest.config.unit.js --coverage --no-file-parallelism && vitest --config vitest.integration.config.js --coverage",
    "test:playwright": "playwright test",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:report": "playwright show-report",
    "test:playwright:install": "playwright install",
    "test:playwright:payments": "playwright test --grep=\"Payment Flows\"",
    "test:playwright:users": "playwright test --grep=\"User Management\"",
    "seed": "node src/scripts/seedDatabase.js",
    "create-admin": "node src/scripts/createAdminUser.js",
    "test:email": "node src/scripts/testEmailService.js",
    "test:email:simple": "node src/scripts/testEmailServiceSimple.js",
    "test:ses": "node src/scripts/testEmailServiceSES.js",
    "validate:paypal": "node src/scripts/validatePayPalCredentials.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "echo 'No TypeScript configuration'",
    "clean": "rm -rf node_modules coverage test-results logs/*.log",
    "build": "echo 'No build step required for Node.js backend'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-ses": "^3.826.0",
    "@aws-sdk/client-sns": "^3.864.0",
    "@aws-sdk/credential-providers": "^3.826.0",
    "@paypal/paypal-server-sdk": "^1.1.0",
    "@sentry/node": "^9.29.0",
    "@sentry/profiling-node": "^9.29.0",
    "@vitest/utils": "^3.2.4",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "isomorphic-dompurify": "^2.25.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "newrelic": "^13.20.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.10",
    "qrcode.react": "^4.2.0",
    "sharp": "^0.34.2",
    "sitemap": "^8.0.0",
    "uuid": "^11.1.0",
    "validator": "^13.15.15",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "c8": "^10.1.3",
    "eslint": "^9.0.0",
    "mongodb-memory-server": "^10.1.4",
    "msw": "^2.10.2",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1",
    "vitest": "^4.1.8"
  }
}
