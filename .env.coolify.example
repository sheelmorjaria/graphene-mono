# Coolify Environment Configuration
# Copy this file to .env in Coolify and fill in your values

# Database Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_mongo_password
MONGO_DATABASE=graphene_store

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password

# JWT & Session Secrets
JWT_SECRET=your_secure_jwt_secret_min_32_chars
SESSION_SECRET=your_secure_session_secret_min_32_chars

# URLs (Update these with your actual domain)
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=production
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Bitcoin Configuration (Blockonomics)
BLOCKONOMICS_API_KEY=your_blockonomics_api_key
BLOCKONOMICS_WEBHOOK_SECRET=your_blockonomics_webhook_secret

# Monero Configuration (NOWPayments)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-2
AWS_S3_BUCKET=your_s3_bucket_name
AWS_SES_FROM_EMAIL=noreply@your-domain.com

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn
NEW_RELIC_LICENSE_KEY=your_new_relic_key

# Logging
LOG_LEVEL=info

# Admin User (for initial setup)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=your_secure_admin_password