# Tor Hidden Service Environment Configuration
# Copy this to .env.tor and configure for your Tor deployment

# Database Configuration (same as clearnet)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_mongo_password
MONGO_DATABASE=graphene_store

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password

# JWT & Session Secrets (use different ones from clearnet for extra security)
JWT_SECRET=your_tor_specific_jwt_secret_min_32_chars
SESSION_SECRET=your_tor_specific_session_secret_min_32_chars

# Tor Onion URLs (will be generated automatically, update after first run)
TOR_FRONTEND_URL=http://youronionaddress.onion
TOR_BACKEND_URL=http://yourapiaddress.onion

# PayPal Configuration (may not work well over Tor)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=production

# Bitcoin Configuration (Blockonomics) - Works great with Tor!
BLOCKONOMICS_API_KEY=your_blockonomics_api_key
BLOCKONOMICS_WEBHOOK_SECRET=your_blockonomics_webhook_secret
# Use Tor-friendly Bitcoin node
BITCOIN_NODE_URL=http://blockstream.onion

# Monero Configuration (NOWPayments) - Privacy-focused, perfect for Tor
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret

# AWS Configuration (Consider privacy implications)
# For Tor deployment, consider using local storage instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_SES_FROM_EMAIL=

# Monitoring (Disable for maximum privacy)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Logging (More verbose for debugging Tor issues)
LOG_LEVEL=debug

# Tor-specific settings
ENABLE_TOR=true
TRUST_PROXY=true
CORS_ALLOW_ONION=true
DISABLE_ANALYTICS=true
DISABLE_EXTERNAL_SCRIPTS=true
ENHANCED_PRIVACY_MODE=true

# Security settings for Tor
MAX_LOGIN_ATTEMPTS=3
SESSION_TIMEOUT=1800
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=50

# Tor SOCKS proxy (if backend needs to make external requests)
TOR_SOCKS_PROXY=socks5h://tor:9050

# Privacy-focused email service (instead of AWS SES)
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=your-proton-email@protonmail.com
SMTP_PASS=your-proton-password
SMTP_FROM=noreply@youronion.onion