{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM node:20-alpine AS builder",
    "WORKDIR /app",
    "COPY apps/frontend/package*.json ./",
    "COPY apps/frontend ./",
    "WORKDIR /app",
    "RUN npm install --legacy-peer-deps",
    "RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont",
    "ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser",
    "ARG VITE_API_BASE_URL",
    "ARG VITE_PAYPAL_CLIENT_ID",
    "ARG VITE_APP_TITLE",
    "ARG VITE_COMPANY_NAME",
    "ARG VITE_SUPPORT_EMAIL",
    "ARG VITE_ENABLE_PAYPAL_PAYMENTS",
    "ARG VITE_ENABLE_BITCOIN_PAYMENTS",
    "ARG VITE_ENABLE_MONERO_PAYMENTS",
    "ARG VITE_ENABLE_DEV_TOOLS",
    "ENV VITE_API_BASE_URL=$VITE_API_BASE_URL",
    "ENV VITE_PAYPAL_CLIENT_ID=$VITE_PAYPAL_CLIENT_ID",
    "ENV VITE_APP_TITLE=$VITE_APP_TITLE",
    "ENV VITE_COMPANY_NAME=$VITE_COMPANY_NAME",
    "ENV VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL",
    "ENV VITE_ENABLE_PAYPAL_PAYMENTS=$VITE_ENABLE_PAYPAL_PAYMENTS",
    "ENV VITE_ENABLE_BITCOIN_PAYMENTS=$VITE_ENABLE_BITCOIN_PAYMENTS",
    "ENV VITE_ENABLE_MONERO_PAYMENTS=$VITE_ENABLE_MONERO_PAYMENTS",
    "ENV VITE_ENABLE_DEV_TOOLS=$VITE_ENABLE_DEV_TOOLS",
    "RUN npm run build",
    "RUN node scripts/prerender.mjs",
    "FROM node:20-alpine",
    "WORKDIR /app",
    "COPY --from=builder /app/dist ./dist",
    "COPY --from=builder /app/server.js ./server.js",
    "RUN apk add --no-cache curl",
    "EXPOSE 3000",
    "CMD [\"node\", \"server.js\"]"
  ],
  "containerHttpPort": 3000,
  "envVars": [
    {
      "id": "VITE_API_BASE_URL",
      "description": "Backend API URL (use backend CapRover URL or /api for same domain)",
      "defaultValue": "/api",
      "advanced": false
    },
    {
      "id": "VITE_PAYPAL_CLIENT_ID",
      "description": "PayPal client ID for the JS SDK \u2014 MUST be the same PayPal app as the backend's PAYPAL_CLIENT_ID (baked at build time)",
      "defaultValue": "",
      "advanced": false
    },
    {
      "id": "INDEXNOW_KEY",
      "description": "IndexNow key (runtime, not baked): server.js serves /<key>.txt for search-engine verification. Set the SAME value on the backend app. Leave empty to disable.",
      "defaultValue": "",
      "advanced": true
    },
    {
      "id": "VITE_APP_TITLE",
      "description": "Application title",
      "defaultValue": "GrapheneOS Store",
      "advanced": false
    },
    {
      "id": "VITE_COMPANY_NAME",
      "description": "Company name",
      "defaultValue": "Graphene Security",
      "advanced": false
    },
    {
      "id": "VITE_SUPPORT_EMAIL",
      "description": "Support email address",
      "defaultValue": "support@graphene-security.com",
      "advanced": false
    },
    {
      "id": "VITE_ENABLE_PAYPAL_PAYMENTS",
      "description": "Enable PayPal payment gateway",
      "defaultValue": "true",
      "advanced": true
    },
    {
      "id": "VITE_ENABLE_BITCOIN_PAYMENTS",
      "description": "Enable Bitcoin payments via Blockonomics",
      "defaultValue": "true",
      "advanced": true
    },
    {
      "id": "VITE_ENABLE_MONERO_PAYMENTS",
      "description": "Enable Monero payments via GloBee",
      "defaultValue": "false",
      "advanced": true
    },
    {
      "id": "VITE_ENABLE_DEV_TOOLS",
      "description": "Enable developer tools in production",
      "defaultValue": "false",
      "advanced": true
    }
  ],
  "volumes": [],
  "hasDefaultSubDomain": true
}
