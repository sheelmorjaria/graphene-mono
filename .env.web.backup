# Web deployment environment variables
# Copy this to .env for web deployment

# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_password_here
MONGO_DATABASE=graphene_store
MONGODB_URI=mongodb://admin:your_secure_password_here@mongodb:27017/graphene_store?authSource=admin

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here

# Backend Configuration
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here
PORT=5000

# Frontend Configuration - Web Version
VITE_API_BASE_URL=https://api.graphene-security.com/api
VITE_APP_TITLE=GrapheneOS Store
VITE_COMPANY_NAME=Graphene Security
VITE_SUPPORT_EMAIL=support@grapheneos-store.com

# Payment Configuration - All payments enabled for web
VITE_ENABLE_PAYPAL_PAYMENTS=true
VITE_ENABLE_BITCOIN_PAYMENTS=true
VITE_ENABLE_MONERO_PAYMENTS=true

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret

# Crypto Configuration
BLOCKONOMICS_API_KEY=your_blockonomics_key
MONERO_WALLET_ADDRESS=your_monero_address

# Feature Flags
VITE_ENABLE_DEV_TOOLS=false
VITE_MAINTENANCE_MODE=false